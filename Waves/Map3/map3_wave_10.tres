[sub_resource type="Resource" id="Resource_witch"]
script = ExtResource("1_cfg")
cena = ExtResource("3_witch")
cor = Color(0.65, 0.2, 0.9, 1)
icone = ExtResource("icon_witch")
descricao = "A Bruxa: boss do mapa. Invoca servos e usa magia. Derrote-a para vencer."

[sub_resource type="Resource" id="Resource_franke"]
script = ExtResource("1_cfg")
cena = ExtResource("4_franke")
quantidade = 2
cor = Color(0.25, 0.8, 0.25, 1)
icone = ExtResource("icon_frank")
descricao = "Franke: tanque lento com muita vida. Foque torres de alto dano nele."

[sub_resource type="Resource" id="Resource_abo"]
script = ExtResource("1_cfg")
cena = ExtResource("5_abo")
quantidade = 4
cor = Color(0.95, 0.5, 0.1, 1)
icone = ExtResource("icon_abo")
descricao = "Abóbora: inimigo rápido e fraco. Derrota fácil, mas vem em grupo."

[sub_resource type="Resource" id="Resource_knight"]
script = ExtResource("1_cfg")
cena = ExtResource("6_knight")
quantidade = 3
cor = Color(0.45, 0.35, 0.95, 1)
icone = ExtResource("icon_knight")
descricao = "Cavaleiro: mais resistente e lento. Absorve dano antes de cair."

[resource]
script = ExtResource("2_wave")
nome_da_onda = "Mapa 3 - Onda Final"
descricao = "A Bruxa chega com sua guarda. Derrote-a para libertar o cemitério."
